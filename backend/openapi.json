    "/api/handles/{handle}/queue": {
      "get": {
        "summary": "Queue",
        "description": "Today's upsolve queue, deterministic per (handle, date).",
        "operationId": "queue_api_handles__handle__queue_get",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Handle"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD (UTC); default today",
              "title": "Date"
            },
            "description": "YYYY-MM-DD (UTC); default today"
          },
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 5,
              "title": "N"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Skipped problems: 1700-C,1701-A",
              "title": "Exclude"
            },
            "description": "Skipped problems: 1700-C,1701-A"
          },
          {
            "name": "band_lo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5000,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Band Lo"
            }
          },
          {
            "name": "band_hi",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5000,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Band Hi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueOut"
