  "paths": {
    "/api/handles/{handle}/sync": {
      "post": {
        "summary": "Sync Handle",
        "description": "Enqueue a sync, or return the cached state if synced in the last 10 minutes.",
        "operationId": "sync_handle_api_handles__handle__sync_post",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Handle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
